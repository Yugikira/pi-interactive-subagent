{
  "name": "interactive-subagents",
  "version": "3.10.8",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr (pi, agy, claude, codex, grok, opencode)",
  "keywords": [
    "pi-package",
    "herdr",
    "subagents"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/test.ts test/signals.test.ts test/model-config.test.ts test/agents.test.ts test/config.test.ts test/runners.test.ts test/completion.test.ts test/status-stale.test.ts test/monitor.test.ts test/layout.test.ts test/system-prompt-mode.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
